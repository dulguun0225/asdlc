# All-Projects project.config — variants/self-hosted.md §5 as code.
# bootstrap.mjs pushes this to refs/meta/config (with a groups file carrying
# the UUIDs of the two groups it creates: "humans" and "ci").
#
# The §5 rules this file implements, and how:
#   - Nobody holds Push on refs/heads/*   → no push line in that section.
#   - Forge Author is not granted         → no forgeAuthor line anywhere.
#   - Merge gate, producer exclusion      → submit-requirement "Code-Review":
#     label:Code-Review=MAX&user=non_contributor (excludes author, committer
#     and uploader in one rule; operator per Gerrit config-submit-requirements
#     docs, checked 2026-08-10).
#   - Requester exclusion                 → submit-requirement "Human-Review":
#     users=human_reviewers ignores service-user and change-owner votes;
#     the agent account is in Service Users.
#   - Verified restricted to Zuul         → label-Verified only for group ci,
#     whose one member is the zuul account. Restricting it to Service Users
#     instead would let the agent (also a service user) verify itself.
#   - Human votes are human-only          → label-Code-Review only for group
#     humans; Zuul's gate pipeline requires the max vote before any gate job
#     runs, Gerrit's label permission bounds who can cast it.
#   - One human label (ADR-0046)          → no Workflow label; Code-Review
#     carries approval and gate release in one vote, values -1/0/+1: veto,
#     silence, approve. Not -2/0/+2: Gerrit normalizes a label's values to
#     the contiguous range between min and max, so a sparse set grows empty
#     intermediate votes back (observed live 2026-08-11, Gerrit 3.14.2;
#     the config-labels docs state no such constraint). Intermediate votes
#     are traps here: under Human-Review's all-must-approve shape, any
#     human vote below MAX blocks.
#   - ACL changes platform-owner-only     → refs/meta/config votable and
#     submittable by Administrators only, whose members are the platform
#     owner and backup; the submit requirements still demand a second human.
#   - Votes never carried across patch sets (artifacts.md §3: a new patch set
#     is a new thing to approve) → no copyCondition except is:MIN, which
#     carries only blocking votes.
#
# Deliberately absent, recorded in the README: the code-owners plugin (T1
# path ownership) — installing it unconfigured blocks every submit.

[project]
	description = Access inherited by all other projects.
[receive]
	requireContributorAgreement = false
	requireSignedOffBy = false
	requireChangeId = true
	enableSignedPush = false
[submit]
	mergeContent = true
[capability]
	administrateServer = group Administrators
	priority = batch group Service Users
	streamEvents = group Service Users
[access "refs/*"]
	read = group Administrators
	read = group Registered Users
[access "refs/for/refs/*"]
	push = group Registered Users
[access "refs/for/*"]
	addPatchSet = group Registered Users
[access "refs/heads/*"]
	create = group Administrators
	label-Code-Review = -1..+1 group humans
	label-Verified = -2..+2 group ci
	submit = group Administrators
	submit = group ci
[access "refs/meta/config"]
	exclusiveGroupPermissions = read
	read = group Administrators
	create = group Administrators
	label-Code-Review = -1..+1 group Administrators
	submit = group Administrators
[access "refs/tags/*"]
	create = group Administrators
	createTag = group Administrators
	createSignedTag = group Administrators
[label "Code-Review"]
	function = NoBlock
	defaultValue = 0
	value = -1 This shall not be merged
	value = 0 No score
	value = +1 Approved and released to the gate
	copyCondition = is:MIN
[label "Verified"]
	function = NoBlock
	defaultValue = 0
	value = -2 Fails
	value = -1 Does not seem to work
	value = 0 No score
	value = +1 Works for me
	value = +2 Verified
[submit-requirement "Code-Review"]
	description = A maximum Code-Review vote from someone who is not the \
	              author, committer or uploader. A minimum vote is blocking.
	submittableIf = label:Code-Review=MAX&user=non_contributor AND -label:Code-Review=MIN
[submit-requirement "Human-Review"]
	description = The approving Code-Review vote must come from a human \
	              reviewer: service users and the change owner are ignored.
	submittableIf = label:Code-Review=MAX&users=human_reviewers
[submit-requirement "Verified"]
	description = Zuul's gate pipeline must have verified the change. \
	              Not applicable on refs/meta/config, where no jobs run.
	applicableIf = -branch:refs/meta/config
	submittableIf = label:Verified=MAX AND -label:Verified=MIN
